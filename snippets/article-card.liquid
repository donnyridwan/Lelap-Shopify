{%- comment -%}
  Sleep Library article card (Figma: Article Card). Works with a real article or with fallback data.
  Params: article (optional), title, url, tag, read, image_asset, class, sizes, heading_tag
{%- endcomment -%}
{%- liquid
  assign c_title = title
  assign c_url = url
  assign c_tag = tag
  assign c_read = read
  if article != blank
    assign c_title = article.title
    assign c_url = article.url
    assign c_tag = article.tags.first
    assign c_read = article.metafields.lelap.read_time.value
    if c_read == blank
      assign words = article.content | strip_html | split: ' ' | size
      assign mins = words | divided_by: 200 | at_least: 1
      assign c_read = 'blogs.article.min_read' | t: count: mins
    endif
  endif
  assign tag_name = heading_tag | default: 'h3'
-%}
<article class="blog-card{% if class %} {{ class }}{% endif %}" data-blog-card>
  <a href="{{ c_url }}" class="blog-card__media" tabindex="-1" aria-hidden="true">
    {%- if article != blank and article.image != blank -%}
      {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: sizes | default: '(min-width: 1200px) 411px, 100vw', widths: '400, 600, 820, 1200', alt: article.image.alt | default: c_title }}
    {%- elsif image_asset != blank -%}
      <img src="{{ image_asset | asset_url }}" alt="" width="411" height="240" loading="lazy">
    {%- endif -%}
  </a>
  <p class="blog-card__meta">
    {%- if c_tag != blank -%}<span class="blog-card__tag">{{ c_tag | escape }}</span>{%- endif -%}
    {%- if c_read != blank -%}<span>{{ c_read | escape }}</span>{%- endif -%}
  </p>
  <{{ tag_name }} class="blog-card__title"><a href="{{ c_url }}">{{ c_title | escape }}</a></{{ tag_name }}>
</article>
