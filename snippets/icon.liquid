{%- comment -%}
  Renders a Figma-exported icon. Strokes/fills use currentColor so the icon
  inherits text color; the design's default color is applied when no `color` param is passed.
  Usage: {% render 'icon', name: 'cart', color: '#1d2142', size: 22 %}
{%- endcomment -%}
{%- liquid
  assign c = color
  case name
    when 'truck', 'steth', 'phone', 'spark', 'refresh', 'send'
      assign d = '#ffffff'
    when 'check'
      assign d = '#c3c0e8'
    when 'bottle', 'x', 'lock', 'tag', 'eye', 'box', 'pin', 'user', 'out', 'clip', 'edit'
      assign d = '#5f6179'
    when 'mail'
      assign d = '#2f8f5b'
    when 'home', 'cal', 'undo'
      assign d = '#3f3478'
    when 'alert'
      assign d = '#c2413a'
    else
      assign d = '#1d2142'
  endcase
  if c == blank
    assign c = d
  endif
-%}
<span class="icon icon--{{ name }}{% if class %} {{ class }}{% endif %}" style="color: {{ c }};{% if size %} width: {{ size }}px; height: {{ size }}px;{% endif %}" aria-hidden="true">
