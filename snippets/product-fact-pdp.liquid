{%- comment -%}
  Product page / Shop All facts for the four lelap formulas (Figma: Product · Sleep * and Shop All Formulas).
  Called by snippets/product-fact.liquid when neither the lelap.<key> metafield nor its own defaults have a value.
  Params: handle, key
{%- endcomment -%}
{%- liquid
  assign fact = ''
  case handle
    when 'sleep-classic'
      case key
        when 'short_tagline'
          assign fact = 'For falling asleep'
        when 'upsell'
          assign fact = 'For falling asleep'
        when 'intro'
          assign fact = 'Low-dose melatonin gummies with chamomile and L-theanine. Designed to help you fall asleep faster and wake up clear-headed, with your dose set by a licensed doctor.*'
        when 'highlights'
          assign fact = '3 mg melatonin|Vegan & gelatin-free|0 g added sugar|Made to wear off by morning'
        when 'doctor_note'
          assign fact = 'Melatonin needs a quick doctor review. Answer 10 questions at checkout. If it isn’t right for you, you get a full refund.'
        when 'benefits'
          assign fact = 'Fall asleep sooner::A low, steady 3 mg dose nudges your body clock toward sleep.*|Wake up clear::Made to wear off by morning, so you don’t start the day foggy.*|Wind down calmly::L-theanine and chamomile support a quieter mind at bedtime.*|Doctor-guided::Your dose is reviewed, and adjusted after your first month.'
        when 'facts'
          assign fact = 'Calories::10|Total sugars::0 g|Melatonin::3 mg|Chamomile extract::50 mg|L-theanine::50 mg'
        when 'other_ingredients'
          assign fact = 'Other ingredients: fruit pectin, tapioca syrup, natural blueberry and lavender flavours, citric acid, vegetable juice (colour), erythritol.'
        when 'routine_4_title'
          assign fact = 'Wake up clear'
        when 'compare_best_for'
          assign fact = 'Falling asleep'
        when 'key_actives'
          assign fact = 'Melatonin 3 mg, chamomile, L-theanine'
        when 'melatonin'
          assign fact = '3 mg'
        when 'when_to_take'
          assign fact = '30–60 min before bed'
        when 'flavour'
          assign fact = 'Blueberry lavender'
      endcase
    when 'sleep-deep'
      case key
        when 'short_tagline'
          assign fact = 'For waking up at night'
        when 'upsell'
          assign fact = 'For waking up at night'
        when 'intro'
          assign fact = 'Melatonin with magnesium glycinate. Designed to help you stay asleep through the night and fall back asleep faster if you wake, with your dose set by a licensed doctor.*'
        when 'highlights'
          assign fact = '3 mg melatonin|100 mg magnesium glycinate|0 g added sugar|Vegan & gelatin-free'
        when 'doctor_note'
          assign fact = 'Melatonin needs a quick doctor review. Answer 10 questions at checkout. If it isn’t right for you, you get a full refund.'
        when 'benefits'
          assign fact = 'Stay asleep longer::Magnesium glycinate supports deeper, more continuous sleep.*|Fewer 3am wake-ups::A steady dose helps you drift back off if you wake.*|Wind down calmly::L-theanine and chamomile support a quieter mind at bedtime.*|Doctor-guided::Your dose is reviewed, and adjusted after your first month.'
        when 'facts'
          assign fact = 'Calories::10|Total sugars::0 g|Melatonin::3 mg|Magnesium glycinate::100 mg|L-theanine::50 mg'
        when 'other_ingredients'
          assign fact = 'Other ingredients: fruit pectin, tapioca syrup, natural wild berry flavours, citric acid, vegetable juice (colour), erythritol.'
        when 'routine_4_title'
          assign fact = 'Fewer 3am wake-ups'
        when 'compare_best_for'
          assign fact = 'Waking at night'
        when 'key_actives'
          assign fact = 'Melatonin 3 mg, magnesium glycinate'
        when 'melatonin'
          assign fact = '3 mg'
        when 'when_to_take'
          assign fact = '30–60 min before bed'
        when 'flavour'
          assign fact = 'Wild berry'
      endcase
    when 'sleep-reset'
      case key
        when 'short_tagline'
          assign fact = 'For jet lag & shift work'
        when 'upsell'
          assign fact = 'For jet lag & shift work'
        when 'intro'
          assign fact = 'A gentle 1 mg melatonin dose, timed to your new bedtime. Designed to help your body clock adjust after long flights or a change in shifts, with your dose set by a licensed doctor.*'
        when 'highlights'
          assign fact = '1 mg melatonin|Timed to your destination|0 g added sugar|Vegan & gelatin-free'
        when 'doctor_note'
          assign fact = 'Melatonin needs a quick doctor review. Answer 10 questions at checkout. If it isn’t right for you, you get a full refund.'
        when 'benefits'
          assign fact = 'Adjust faster::A small, well-timed dose helps shift your body clock.*|Sleep on new hours::Made for red-eyes, time zones and rotating shifts.*|Wind down calmly::L-theanine and chamomile support a quieter mind at bedtime.*|Doctor-guided::Your dose is reviewed, and adjusted after your first month.'
        when 'facts'
          assign fact = 'Calories::10|Total sugars::0 g|Melatonin::1 mg|Chamomile extract::25 mg|L-theanine::25 mg'
        when 'other_ingredients'
          assign fact = 'Other ingredients: fruit pectin, tapioca syrup, natural peach flavours, citric acid, vegetable juice (colour), erythritol.'
        when 'routine_4_title'
          assign fact = 'Sleep on new hours'
        when 'compare_best_for'
          assign fact = 'Jet lag & shifts'
        when 'key_actives'
          assign fact = 'Melatonin 1 mg'
        when 'melatonin'
          assign fact = '1 mg'
        when 'when_to_take'
          assign fact = 'Bedtime at your destination'
        when 'flavour'
          assign fact = 'Peach'
      endcase
    when 'sleep-calm'
      case key
        when 'short_tagline'
          assign fact = 'Melatonin-free, for a busy mind'
        when 'upsell'
          assign fact = 'For nights your mind won’t switch off'
        when 'intro'
          assign fact = 'A melatonin-free blend of L-theanine, chamomile and lemon balm. Designed to quiet a busy mind at bedtime without affecting your body clock, reviewed by a licensed doctor.*'
        when 'highlights'
          assign fact = 'Melatonin-free|200 mg L-theanine|0 g added sugar|Vegan & gelatin-free'
        when 'doctor_note'
          assign fact = 'Every order includes a quick doctor review. Answer 10 questions at checkout. If it isn’t right for you, you get a full refund.'
        when 'benefits'
          assign fact = 'Quiet a busy mind::L-theanine and lemon balm support a calmer wind-down.*|No melatonin::Ideal if melatonin isn’t right for you, or you just need to switch off.*|Wind down calmly::L-theanine and chamomile support a quieter mind at bedtime.*|Doctor-guided::Your dose is reviewed, and adjusted after your first month.'
        when 'facts'
          assign fact = 'Calories::10|Total sugars::0 g|L-theanine::200 mg|Chamomile extract::100 mg|Lemon balm extract::80 mg'
        when 'other_ingredients'
          assign fact = 'Other ingredients: fruit pectin, tapioca syrup, natural chamomile and honey flavours, citric acid, vegetable juice (colour), erythritol.'
        when 'routine_4_title'
          assign fact = 'No melatonin'
        when 'compare_best_for'
          assign fact = 'A busy mind'
        when 'key_actives'
          assign fact = 'L-theanine, chamomile'
        when 'melatonin'
          assign fact = 'None'
        when 'when_to_take'
          assign fact = '30 min before bed'
        when 'flavour'
          assign fact = 'Chamomile honey'
      endcase
  endcase
  echo fact
-%}
