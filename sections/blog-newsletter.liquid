{%- comment -%} Figma: Sleep Library › Newsletter ("Sleep notes, once a month"). {%- endcomment -%}
<section class="blog-news">
  <div class="container blog-news__inner">
    <div class="blog-news__copy">
      <h2 class="blog-news__title">{{ section.settings.heading | escape }}</h2>
      <p class="blog-news__text">{{ section.settings.text | escape }}</p>
    </div>
    {%- form 'customer', id: 'BlogNewsletter', class: 'blog-news__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, sleep-notes">
      {%- if form.posted_successfully? -%}
        <p class="blog-news__msg" role="status">{{ section.settings.success | escape }}</p>
      {%- else -%}
        <div class="blog-news__field">
          <label for="BlogNewsletterEmail" class="visually-hidden">{{ section.settings.placeholder | escape }}</label>
          <input id="BlogNewsletterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ section.settings.placeholder | escape }}">
          <button type="submit" class="btn btn--primary">{{ section.settings.button | escape }}</button>
        </div>
        {%- if form.errors -%}<p class="blog-news__msg" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Sleep notes signup",
  "class": "section-blog-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sleep notes, once a month" },
    { "type": "text", "id": "text", "label": "Text", "default": "One short, doctor-reviewed email. No spam, unsubscribe anytime." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Email address" },
    { "type": "text", "id": "button", "label": "Button", "default": "Subscribe" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thanks for subscribing — see you next month." }
  ],
  "presets": [{ "name": "Sleep notes signup" }]
}
{% endschema %}
