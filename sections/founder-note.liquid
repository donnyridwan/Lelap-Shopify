{%- comment -%} Figma: About Us › Founder Note. {%- endcomment -%}
<section class="pg about-founder">
  <div class="container about-founder__inner">
    <div class="about-founder__avatar" data-reveal>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '200px', alt: section.settings.name }}
      {%- elsif section.settings.initials != blank -%}
        <span aria-hidden="true">{{ section.settings.initials | escape }}</span>
      {%- else -%}
        <img src="{{ 'photo-founder.jpg' | asset_url }}" width="600" height="600" loading="lazy" alt="">
      {%- endif -%}
    </div>
    <figure class="about-founder__body" data-reveal style="--reveal-delay: 120ms">
      <blockquote class="about-founder__quote">{{ section.settings.quote | escape }}</blockquote>
      <figcaption class="about-founder__name">{{ section.settings.name | escape }}</figcaption>
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "Founder note",
  "class": "section-founder-note",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Founder photo", "info": "Upload the founder's portrait. Without one, a lifestyle photo from the design is shown." },
    { "type": "text", "id": "initials", "label": "Initials (instead of a photo)", "info": "Optional. Shown in the circle when no photo is uploaded." },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "“For two years I took whatever melatonin I could find. Some nights it worked, most mornings I felt awful. A sleep doctor finally told me I was taking five times what I needed. lelap is the version of that conversation everyone should get.”" },
    { "type": "text", "id": "name", "label": "Name and role", "default": "[Founder name], Co-founder" }
  ],
  "presets": [{ "name": "Founder note" }]
}
{% endschema %}
