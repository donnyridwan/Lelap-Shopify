<div class="ticker" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
  {%- for block in section.blocks -%}
    <div class="ticker__item" {{ block.shopify_attributes }}>
      {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon, color: '#ffffff' %}{%- endif -%}
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
      {%- else -%}
        <span>{{ block.settings.text }}</span>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Ticker bar",
  "class": "section-announcement",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Save 20% when you subscribe" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "truck",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "steth", "label": "Stethoscope" },
            { "value": "phone", "label": "Phone" },
            { "value": "spark", "label": "Spark" },
            { "value": "refresh", "label": "Refresh" },
            { "value": "moon", "label": "Moon" }
          ]
        }
      ]
    }
  ],
  "presets": [{ "name": "Ticker bar" }]
}
{% endschema %}
