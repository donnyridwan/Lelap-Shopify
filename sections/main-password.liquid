{%- comment -%}
  /account/reset/… and /account/activate/… — Figma: Account · Set New Password (256:11801).
  After a successful reset Shopify signs the customer in and redirects; we return to
  /account/login?password_updated=1 which shows the "Password updated" state (256:12182).
{%- endcomment -%}
{%- liquid
  assign is_activate = false
  if template.name contains 'activate'
    assign is_activate = true
  endif
-%}
{%- capture fields -%}
  <span class="auth-badge">{% render 'icon', name: 'lock', color: '#1d2142', size: 24 %}</span>
  <h1 class="auth__title">{% if is_activate %}{{ section.settings.activate_title }}{% else %}{{ section.settings.title }}{% endif %}</h1>
  <p class="auth__lead auth__lead--relaxed">{% if is_activate %}{{ section.settings.activate_text }}{% else %}{{ section.settings.text }}{% endif %}</p>
  <div class="auth-field">
    <label class="auth-field__label" for="NewPassword">{{ section.settings.password_label }}</label>
    <div class="auth-field__control">
      <input class="auth-input" type="password" id="NewPassword" name="customer[password]" autocomplete="new-password" minlength="8" required data-pw>
      <button type="button" class="auth-eye" data-eye aria-pressed="false" aria-label="{{ section.settings.show_password | escape }}">{% render 'icon', name: 'eye', color: 'currentColor', size: 18 %}</button>
    </div>
  </div>
  <div class="auth-strength" aria-live="polite">
    <div class="auth-strength__bars" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <p class="auth-strength__label" data-words="{{ section.settings.strength_words | escape }}"></p>
  </div>
  <div class="auth-field">
    <label class="auth-field__label" for="ConfirmPassword">{{ section.settings.confirm_label }}</label>
    <div class="auth-field__control">
      <input class="auth-input" type="password" id="ConfirmPassword" name="customer[password_confirmation]" autocomplete="new-password" minlength="8" required data-pw-confirm>
      <button type="button" class="auth-eye" data-eye aria-pressed="false" aria-label="{{ section.settings.show_password | escape }}">{% render 'icon', name: 'eye', color: 'currentColor', size: 18 %}</button>
    </div>
  </div>
  <ul class="auth-rules">
    <li data-rule="len"><span class="auth-rules__dot">{% render 'icon', name: 'check', color: '#ffffff', size: 10 %}</span>{{ section.settings.rule_len }}</li>
    <li data-rule="num"><span class="auth-rules__dot">{% render 'icon', name: 'check', color: '#ffffff', size: 10 %}</span>{{ section.settings.rule_num }}</li>
    <li data-rule="match"><span class="auth-rules__dot">{% render 'icon', name: 'check', color: '#ffffff', size: 10 %}</span>{{ section.settings.rule_match }}</li>
  </ul>
  <input type="hidden" name="return_to" value="{{ routes.account_login_url }}?password_updated=1">
  <button type="submit" class="btn btn--primary btn--block">{% if is_activate %}{{ section.settings.activate_button }}{% else %}{{ section.settings.button }}{% endif %}</button>
{%- endcapture -%}

<div class="auth">
  <div class="auth__main">
    <div class="auth__form">
      {%- if is_activate -%}
        {%- form 'activate_customer_password', data-password-rules: '' -%}{%- if form.errors -%}<div class="auth-alert" role="alert">{% render 'icon', name: 'alert', size: 18 %}<div><p class="auth-alert__title">{{ section.settings.error_title }}</p><div class="auth-alert__text">{{ form.errors | default_errors }}</div></div></div>{%- endif -%}{{ fields }}{%- endform -%}
      {%- else -%}
        {%- form 'reset_customer_password', data-password-rules: '' -%}{%- if form.errors -%}<div class="auth-alert" role="alert">{% render 'icon', name: 'alert', size: 18 %}<div><p class="auth-alert__title">{{ section.settings.error_title }}</p><div class="auth-alert__text">{{ form.errors | default_errors }}</div></div></div>{%- endif -%}{{ fields }}{%- endform -%}
      {%- endif -%}
    </div>
  </div>
  {% render 'account-auth-aside', image: section.settings.image, quote: section.settings.quote, cite: section.settings.cite %}
</div>

<script src="{{ 'account.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Set password",
  "tag": "section",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "title", "label": "Reset heading", "default": "Choose a new password" },
    { "type": "textarea", "id": "text", "label": "Reset text", "default": "Make it at least 8 characters with a number. You’ll be logged out of other devices." },
    { "type": "text", "id": "button", "label": "Reset button", "default": "Update password" },
    { "type": "text", "id": "activate_title", "label": "Activation heading", "default": "Choose a password" },
    { "type": "textarea", "id": "activate_text", "label": "Activation text", "default": "Make it at least 8 characters with a number to activate your lelap account." },
    { "type": "text", "id": "activate_button", "label": "Activation button", "default": "Activate account" },
    { "type": "text", "id": "password_label", "label": "Password label", "default": "New password" },
    { "type": "text", "id": "confirm_label", "label": "Confirm label", "default": "Confirm new password" },
    { "type": "text", "id": "show_password", "label": "Show password label (screen readers)", "default": "Show password" },
    { "type": "text", "id": "strength_words", "label": "Strength labels (weak|fair|good|strong)", "default": "Weak password|Fair password|Good password|Strong password" },
    { "type": "text", "id": "rule_len", "label": "Rule: length", "default": "At least 8 characters" },
    { "type": "text", "id": "rule_num", "label": "Rule: number", "default": "Includes a number" },
    { "type": "text", "id": "rule_match", "label": "Rule: match", "default": "Passwords match" },
    { "type": "text", "id": "error_title", "label": "Error title", "default": "We couldn’t update your password" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "“Waking up without that heavy, foggy feeling is the best part.”" },
    { "type": "text", "id": "cite", "label": "Quote author", "default": "Ayu S., Bandung, subscriber since 2025" }
  ]
}
{% endschema %}
