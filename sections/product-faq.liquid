{%- comment -%} Figma: Product · FAQ ("Questions about Sleep Classic") — FAQ Row component, first row open. {%- endcomment -%}
{%- assign p_title = product.title | default: 'Sleep Classic' -%}
<section class="pdp-faq">
  <div class="container">
    <h2 class="pdp-faq__title">{{ section.settings.heading | replace: '[product]', p_title }}</h2>
    <div class="pdp-faq__list" data-accordion="{% if section.settings.single %}single{% else %}multi{% endif %}">
      {%- for block in section.blocks -%}
        <details class="faq-row"{% if forloop.first and section.settings.open_first %} open{% endif %} {{ block.shopify_attributes }}>
          <summary class="faq-row__q">
            <span>{{ block.settings.question }}</span>
            <span class="faq-row__icon faq-row__icon--plus" aria-hidden="true">{% render 'icon', name: 'plus', size: 22 %}</span>
            <span class="faq-row__icon faq-row__icon--minus" aria-hidden="true">{% render 'icon', name: 'minus', size: 22 %}</span>
          </summary>
          <div class="faq-row__a rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "[product] is replaced by the product title.", "default": "Questions about [product]" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "checkbox", "id": "single", "label": "Only one answer open at a time", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Can I take it every night?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>For most healthy adults, low-dose melatonin is well tolerated for short-term use. Your doctor sets your dose and how long to take it, and checks in after your first month.</p>" }
      ]
    }
  ],
  "presets": [{
    "name": "Product FAQ",
    "blocks": [
      { "type": "question", "settings": { "question": "Can I take it every night?", "answer": "<p>For most healthy adults, low-dose melatonin is well tolerated for short-term use. Your doctor sets your dose and how long to take it, and checks in after your first month.</p>" } },
      { "type": "question", "settings": { "question": "Will I feel groggy in the morning?", "answer": "<p>At 3 mg most people don’t. If you do, your doctor can lower your dose.</p>" } },
      { "type": "question", "settings": { "question": "Can I take it with other medication?", "answer": "<p>Tell your doctor about everything you take. Some medicines, like blood thinners, need extra care.</p>" } },
      { "type": "question", "settings": { "question": "How long does one pouch last?", "answer": "<p>30 gummies, so about a month at one gummy a night.</p>" } }
    ]
  }]
}
{% endschema %}
