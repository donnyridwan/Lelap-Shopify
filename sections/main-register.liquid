{%- comment -%} /account/register — Figma: Account · Create Account (242:1318 / 242:1425 / 250:8959). {%- endcomment -%}
<div class="auth">
  <div class="auth__main">
    <div class="auth__form">
      {%- form 'create_customer', novalidate: 'novalidate' -%}
        <h1 class="auth__title">{{ section.settings.title }}</h1>
        <p class="auth__lead">{{ section.settings.text }}</p>
        {%- if section.settings.social_url != blank -%}
          <a href="{{ section.settings.social_url }}" class="auth-social"><span class="auth-social__g" aria-hidden="true">G</span>{{ section.settings.social_label }}</a>
          <p class="auth-or">{{ section.settings.or_label }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="auth-alert" role="alert">
            {% render 'icon', name: 'alert', size: 18 %}
            <div><p class="auth-alert__title">{{ section.settings.error_title }}</p><div class="auth-alert__text">{{ form.errors | default_errors }}</div></div>
          </div>
        {%- endif -%}
        <div class="auth-row">
          <div class="auth-field">
            <label class="auth-field__label" for="RegisterFirst">{{ section.settings.first_label }}</label>
            <input class="auth-input" type="text" id="RegisterFirst" name="customer[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
          </div>
          <div class="auth-field">
            <label class="auth-field__label" for="RegisterLast">{{ section.settings.last_label }}</label>
            <input class="auth-input" type="text" id="RegisterLast" name="customer[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
          </div>
        </div>
        <div class="auth-field{% if form.errors contains 'email' %} auth-field--error{% endif %}">
          <label class="auth-field__label" for="RegisterEmail">{{ section.settings.email_label }}</label>
          <input class="auth-input" type="email" id="RegisterEmail" name="customer[email]" value="{{ form.email }}" autocomplete="email" autocapitalize="off" required>
          {%- if form.errors contains 'email' -%}<p class="auth-field__error">{% render 'icon', name: 'alert', size: 14 %}{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        </div>
        <div class="auth-field{% if form.errors contains 'password' %} auth-field--error{% endif %}">
          <label class="auth-field__label" for="RegisterPassword">{{ section.settings.password_label }}</label>
          <div class="auth-field__control">
            <input class="auth-input" type="password" id="RegisterPassword" name="customer[password]" autocomplete="new-password" minlength="8" placeholder="{{ section.settings.password_placeholder | escape }}" required>
            <button type="button" class="auth-eye" data-eye aria-pressed="false" aria-label="{{ section.settings.show_password | escape }}">{% render 'icon', name: 'eye', color: 'currentColor', size: 18 %}</button>
          </div>
          {%- if form.errors contains 'password' -%}<p class="auth-field__error">{% render 'icon', name: 'alert', size: 14 %}{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>{%- endif -%}
        </div>
        <label class="auth-check auth-check--small">
          <input type="checkbox" name="customer[note][Consent]" value="Agreed to Terms, Privacy Policy and Telehealth consent" required checked>
          <span class="auth-check__box" aria-hidden="true">{% render 'icon', name: 'check', color: '#ffffff', size: 12 %}</span>
          <span>{{ section.settings.consent_html }}</span>
        </label>
        <button type="submit" class="btn btn--primary btn--block">{{ section.settings.button }}</button>
        <p class="auth-switch">{{ section.settings.login_text }} <a href="{{ routes.account_login_url }}">{{ section.settings.login_link }}</a></p>
      {%- endform -%}
    </div>
  </div>
  {% render 'account-auth-aside', image: section.settings.image, quote: section.settings.quote, cite: section.settings.cite %}
</div>

<script src="{{ 'account.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Create account",
  "tag": "section",
  "class": "section-main-register",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Create your account" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Most people create one at checkout. You can also start here and take the quiz after." },
    { "type": "url", "id": "social_url", "label": "Social login link", "info": "Shown as “Continue with Google” when set (requires a social login app)." },
    { "type": "text", "id": "social_label", "label": "Social login label", "default": "Continue with Google" },
    { "type": "text", "id": "or_label", "label": "Divider label", "default": "or" },
    { "type": "text", "id": "first_label", "label": "First name label", "default": "First name" },
    { "type": "text", "id": "last_label", "label": "Last name label", "default": "Last name" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "password_label", "label": "Password label", "default": "Password" },
    { "type": "text", "id": "password_placeholder", "label": "Password placeholder", "default": "At least 8 characters" },
    { "type": "text", "id": "show_password", "label": "Show password label (screen readers)", "default": "Show password" },
    { "type": "inline_richtext", "id": "consent_html", "label": "Consent text", "default": "I agree to the <a href=\"/policies/terms-of-service\">Terms</a>, <a href=\"/policies/privacy-policy\">Privacy Policy</a> and Telehealth consent." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Create account" },
    { "type": "text", "id": "login_text", "label": "Log in prompt", "default": "Already have an account?" },
    { "type": "text", "id": "login_link", "label": "Log in link label", "default": "Log in" },
    { "type": "text", "id": "error_title", "label": "Error title", "default": "We couldn’t create your account" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "“Waking up without that heavy, foggy feeling is the best part.”" },
    { "type": "text", "id": "cite", "label": "Quote author", "default": "Ayu S., Bandung, subscriber since 2025" }
  ]
}
{% endschema %}
