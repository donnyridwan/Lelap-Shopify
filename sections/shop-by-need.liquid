<section class="need" id="shop-by-need">
  <div class="container need__inner">
    <div class="need__head">
      <h2 class="need__title"><span>{{ section.settings.title_line_1 }}</span> <span class="text-lav">{{ section.settings.title_line_2 }}</span></h2>
      <p class="need__lead">{{ section.settings.lead }}</p>
    </div>

    <div class="need__large" data-scroller>
      <div class="need__large-track" data-scroller-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'need' -%}
            {%- liquid
              assign p = block.settings.product
              assign h = block.settings.handle
              if p != blank
                assign h = p.handle
              endif
              assign link = block.settings.link
              if link == blank
                if p != blank
                  assign link = p.url
                else
                  assign link = '/products/' | append: h
                endif
              endif
            -%}
            <a href="{{ link }}" class="need-tile" {{ block.shopify_attributes }}>
              <span class="need-tile__head">
                <span class="need-tile__title">{{ block.settings.lead }} <span class="text-lav">{{ block.settings.accent }}</span></span>
                <span class="need-tile__right">
                  {%- if block.settings.badge != blank -%}<span class="need-tile__badge">{{ block.settings.badge }}</span>{%- endif -%}
                  {% render 'icon', name: 'chev' %}
                </span>
              </span>
              <span class="need-tile__img">{% render 'product-image', product: p, handle: h, width: 480, sizes: '224px', alt: block.settings.lead %}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="need__small">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'need_small' -%}
            {%- liquid
              assign p = block.settings.product
              assign h = block.settings.handle
              if p != blank
                assign h = p.handle
              endif
              assign link = block.settings.link
              if link == blank
                if p != blank
                  assign link = p.url
                else
                  assign link = '/products/' | append: h
                endif
              endif
            -%}
            <a href="{{ link }}" class="need-small" {{ block.shopify_attributes }}>
              <span class="need-small__title">{{ block.settings.lead }} <span class="text-lav">{{ block.settings.accent }}</span></span>
              <span class="need-small__thumb">{% render 'product-image', product: p, handle: h, width: 160, sizes: '72px', alt: '' %}</span>
              {% render 'icon', name: 'chev' %}
            </a>
          {%- when 'browse' -%}
            <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="need-small need-small--browse" {{ block.shopify_attributes }}>
              <span class="need-small__title">{{ block.settings.label }}</span>
              {% render 'icon', name: 'search' %}
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by need",
  "class": "section-need",
  "settings": [
    { "type": "text", "id": "title_line_1", "label": "Heading line 1", "default": "What’s keeping" },
    { "type": "text", "id": "title_line_2", "label": "Heading line 2 (lavender)", "default": "you up?" },
    { "type": "text", "id": "lead", "label": "Text", "default": "Not sure? The 2-minute quiz matches you to the right formula." }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Large tile",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "lead", "label": "Title", "default": "Fall asleep" },
        { "type": "text", "id": "accent", "label": "Title accent (lavender)", "default": "faster" },
        { "type": "text", "id": "badge", "label": "Badge" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "handle", "label": "Fallback product handle", "default": "sleep-classic", "info": "Used when no product is selected." },
        { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the product page." }
      ]
    },
    {
      "type": "need_small",
      "name": "Small tile",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "lead", "label": "Title", "default": "Wind down" },
        { "type": "text", "id": "accent", "label": "Title accent (lavender)", "default": "at night" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "handle", "label": "Fallback product handle", "default": "sleep-classic" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "browse",
      "name": "Browse all tile",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Browse all products" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by need",
      "blocks": [
        { "type": "need", "settings": { "lead": "Fall asleep", "accent": "faster", "badge": "Popular", "handle": "sleep-classic" } },
        { "type": "need", "settings": { "lead": "Stay", "accent": "asleep", "handle": "sleep-deep" } },
        { "type": "need", "settings": { "lead": "Beat", "accent": "jet lag", "handle": "sleep-reset" } },
        { "type": "need", "settings": { "lead": "Quiet a", "accent": "busy mind", "handle": "sleep-calm" } },
        { "type": "need_small", "settings": { "lead": "Wind down", "accent": "at night", "handle": "sleep-classic" } },
        { "type": "need_small", "settings": { "lead": "After", "accent": "night shifts", "handle": "sleep-reset" } },
        { "type": "need_small", "settings": { "lead": "Ease", "accent": "evening stress", "handle": "sleep-calm" } },
        { "type": "browse", "settings": { "label": "Browse all products" } }
      ]
    }
  ]
}
{% endschema %}
