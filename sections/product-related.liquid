{%- comment -%} Figma: Product · Related ("Other formulas") — the other three lelap formulas. {%- endcomment -%}
{%- liquid
  assign current = product.handle | default: ''
  assign order = 'sleep-deep,sleep-classic,sleep-reset,sleep-calm'
  if current == 'sleep-classic'
    assign order = 'sleep-deep,sleep-reset,sleep-calm'
  elsif current == 'sleep-reset'
    assign order = 'sleep-deep,sleep-classic,sleep-calm'
  elsif current == 'sleep-calm'
    assign order = 'sleep-deep,sleep-reset,sleep-classic'
  elsif current == 'sleep-deep'
    assign order = 'sleep-classic,sleep-reset,sleep-calm'
  endif
  assign handles = order | split: ','
  if section.settings.products != blank
    assign picked = section.settings.products
  endif
-%}
<section class="pdp-related">
  <div class="container">
    <h2 class="pdp-related__title">{{ section.settings.heading }}</h2>
    <ul class="pdp-related__grid">
      {%- if picked != blank -%}
        {%- for p in picked limit: 3 -%}
          {%- unless p.handle == current -%}
            <li>{% render 'mini-product-card', product: p, handle: p.handle %}</li>
          {%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- for hh in handles limit: 3 -%}
          {%- assign p = all_products[hh] -%}{%- unless p.id -%}{%- assign p = nil -%}{%- endunless -%}
          <li>{% render 'mini-product-card', product: p, handle: hh %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Other formulas",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Other formulas" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 4, "info": "Leave empty to show the other three lelap formulas." }
  ],
  "presets": [{ "name": "Other formulas" }]
}
{% endschema %}
