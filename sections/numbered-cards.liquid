{%- comment -%} Figma: About Us › Why We Exist (01 / 02 / 03 cards). {%- endcomment -%}
<section class="pg pg-num-section">
  <div class="container">
    {%- if section.settings.heading != blank -%}<h2 class="pg-title icon-cards__head" data-reveal>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="pg-num-cards" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <div class="pg-num-card" data-reveal style="--reveal-delay: {{ forloop.index0 | times: 80 }}ms" {{ block.shopify_attributes }}>
          <span class="pg-num-card__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="pg-num-card__title">{{ block.settings.title | escape }}</h3>
          <p class="pg-num-card__text">{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Numbered cards",
  "class": "section-numbered-cards",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "The problem" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Many adults struggle with sleep, and most self-treat with whatever is on the shelf, with no one to ask about dose or safety." }
    ] }
  ],
  "presets": [{ "name": "Numbered cards", "blocks": [
    { "type": "card", "settings": { "title": "The problem", "text": "Many adults struggle with sleep, and most self-treat with whatever is on the shelf, with no one to ask about dose or safety." } },
    { "type": "card", "settings": { "title": "Our answer", "text": "A short assessment, a licensed doctor and a low-dose formula matched to your sleep problem." } },
    { "type": "card", "settings": { "title": "Our promise", "text": "If a doctor says lelap isn’t right for you, you get every cent back." } }
  ] }]
}
{% endschema %}
