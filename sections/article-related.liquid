{%- comment -%}
  "Keep reading" (Figma: Article Detail › Related Articles). Shows other articles from the same blog
  (same topic first); falls back to the Figma articles while the blog has too few articles.
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.limit
  assign shown = 0
  assign topic = article.tags.first
  assign ids = ''
-%}
<section class="article-related">
  <div class="container">
    <h2 class="article-related__title" data-reveal>{{ section.settings.heading | escape }}</h2>
    <div class="blog-grid article-related__grid" data-reveal style="--reveal-delay: 80ms">
      {%- if blog != blank and blog.articles_count > 1 -%}
        {%- for a in blog.articles -%}
          {%- if shown < limit and a.id != article.id and topic != blank and a.tags contains topic -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- assign ids = ids | append: ',' | append: a.id | append: ',' -%}
            {% render 'article-card', item: a, heading_tag: 'h3' %}
          {%- endif -%}
        {%- endfor -%}
        {%- for a in blog.articles -%}
          {%- capture needle -%},{{ a.id }},{%- endcapture -%}
          {%- if shown < limit and a.id != article.id -%}
            {%- unless ids contains needle -%}
              {%- assign shown = shown | plus: 1 -%}
              {% render 'article-card', item: a, heading_tag: 'h3' %}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if shown == 0 -%}
        {%- for block in section.blocks limit: limit -%}
          {%- assign b_url = block.settings.url | default: blog.url | default: '/blogs/sleep-library' -%}
          <div {{ block.shopify_attributes }}>
            {% render 'article-card', title: block.settings.title, url: b_url, tag: block.settings.tag, read: block.settings.read, image: block.settings.image, image_asset: block.settings.image_asset %}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Keep reading",
  "class": "section-article-related",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Keep reading" },
    { "type": "range", "id": "limit", "label": "Articles", "min": 3, "max": 6, "step": 3, "default": 3 }
  ],
  "blocks": [
    { "type": "fallback", "name": "Fallback article", "settings": [
      { "type": "paragraph", "content": "Shown only while the blog has no other articles." },
      { "type": "text", "id": "title", "label": "Title", "default": "How to beat jet lag on a Jakarta to Tokyo flight" },
      { "type": "text", "id": "tag", "label": "Topic", "default": "Travel & shifts" },
      { "type": "text", "id": "read", "label": "Read time", "default": "8 min read" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "select", "id": "image_asset", "label": "Design image", "default": "photo-plane.jpg", "options": [
        { "value": "photo-phone-feature.jpg", "label": "Bedside lamp" },
        { "value": "photo-plane.jpg", "label": "Plane window" },
        { "value": "photo-tea-card.jpg", "label": "Tea in bed" },
        { "value": "photo-bedroom-card.jpg", "label": "Bedroom at night" },
        { "value": "photo-ingredients-card.jpg", "label": "Ingredients" },
        { "value": "photo-morning-card.jpg", "label": "Morning stretch" }
      ] },
      { "type": "url", "id": "url", "label": "Link", "info": "Defaults to the blog." }
    ] }
  ],
  "presets": [{ "name": "Keep reading" }]
}
{% endschema %}
