[
  {
    "name": "theme_info",
    "theme_name": "Lelap",
    "theme_version": "1.0.0",
    "theme_author": "Gandaria Studio",
    "theme_documentation_url": "https://github.com/donnyridwan/Lelap-Shopify",
    "theme_support_url": "https://github.com/donnyridwan/Lelap-Shopify"
  },
  {
    "name": "General",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "url",
        "id": "quiz_url",
        "label": "Sleep quiz page",
        "info": "Defaults to /pages/sleep-quiz"
      },
      {
        "type": "text",
        "id": "subscription_discount_label",
        "label": "Subscription savings label",
        "default": "Save 20%"
      },
      {
        "type": "text",
        "id": "rating_summary",
        "label": "Store rating summary",
        "default": "4.8 from 2,300+ reviews"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer",
        "label": "Open cart drawer after adding to cart",
        "default": true
      },
      {
        "type": "text",
        "id": "cart_note",
        "label": "Cart footer note",
        "default": "Free shipping · Free doctor review · Cancel anytime"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "info": "In your store currency. 0 = shipping always free.",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "cart_show_assessment",
        "label": "Always show the 'Sleep assessment completed' note",
        "default": false
      },
      {
        "type": "text",
        "id": "cart_title",
        "label": "Cart title",
        "default": "Your cart"
      },
      {
        "type": "text",
        "id": "cart_checkout_label",
        "label": "Checkout button",
        "default": "Checkout"
      },
      {
        "type": "text",
        "id": "cart_popular_handle",
        "label": "Empty cart: suggested product handle",
        "default": "sleep-classic"
      }
    ]
  },
  {
    "name": "Account",
    "settings": [
      {
        "type": "url",
        "id": "account_care_url",
        "label": "Care team page",
        "info": "Defaults to /pages/care-team"
      },
      {
        "type": "url",
        "id": "account_profile_url",
        "label": "Profile & health page",
        "info": "Defaults to /pages/profile-health"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok"
      }
    ]
  }
]